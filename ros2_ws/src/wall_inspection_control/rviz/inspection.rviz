Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: InspectionMap
      Enabled: true
      Topic:
        Value: /inspection_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Robot
      Enabled: true
      Topic:
        Value: /ground_truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 255; 0
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Focal Point:
        X: 2
        Y: 0
        Z: 1.5
      Distance: 5
      Pitch: 0.1
      Yaw: 3.1416

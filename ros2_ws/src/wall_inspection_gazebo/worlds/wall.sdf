<?xml version="1.0"?>
<sdf version="1.9">
  <world name="wall_world">

    <!-- 物理計算の設定：1 ms ステップ、実時間で進める -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 最低限必要なシステム -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 太陽光：壁の表面（-x 側）を照らす向き -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 壁の表面は x = 2.0（中心 2.1、厚さ 0.2） -->
    <model name="wall">
      <static>true</static>
      <pose>2.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4 3</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 亀裂画像のタイル。モデルの原点を壁の表面（x = 2.0）に合わせる -->
    <include>
      <uri>model://wall_tiles</uri>
      <name>wall_tiles</name>
      <pose>2.0 0 0 0 0 0</pose>
    </include>

    <!-- ピッチ −90° で前方を上、トラックの底を壁（表面 x = 2.0）に向ける -->
    <include>
      <uri>model://crawler</uri>
      <name>crawler</name>
      <pose>1.92 0 1.0 0 -1.5708 0</pose>
    </include>

    <!-- 負圧吸着の模擬。力はワールド座標系なので、壁の向き（+x）に合わせてワールド側に置く -->
    <!-- 必要な力 25.3 kg × 9.81 / μ0.7 ≈ 355 N に余裕を見て 500 N -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench">
      <persistent>
        <entity_name>crawler::base_link</entity_name>
        <entity_type>link</entity_type>
        <force>500 0 0</force>
        <torque>0 0 0</torque>
      </persistent>
    </plugin>

  </world>
</sdf>

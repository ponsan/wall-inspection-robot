<?xml version="1.0"?>
<!--
Crawler model for the wall inspection robot.

Based on examples/worlds/tracked_vehicle_simple.sdf from Gazebo Sim (gz-sim 8)
https://github.com/gazebosim/gz-sim
Licensed under the Apache License, Version 2.0.

Changes from the original:
- Extracted the "simple_tracked" model as a standalone model
- Renamed the model to "crawler"
- Removed the four flippers (links, joints and their TrackController plugins)
- Removed the keyboard teleoperation plugins (TriggeredPublisher)
- Removed the model pose (the position is set in the world file)
- Added an OdometryPublisher plugin to publish the ground-truth pose
-->
<sdf version='1.7'>
    <model name='crawler'>
        <link name='base_link'>
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <pose>-0.122 0 0.118 1.5708 0 0</pose>
                <mass>13.14</mass>
                <inertia>
                    <ixx>0.10019</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.345043</iyy>
                    <iyz>0</iyz>
                    <izz>0.302044</izz>
                </inertia>
            </inertial>
            <collision name='base_link_collision'>
                <pose>-0.122 0 0.118 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.50017 0.24093 0.139</size>
                    </box>
                </geometry>
            </collision>
            <visual name='base_link_visual'>
                <pose>-0.122 0 0.118 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.50017 0.24093 0.139</size>
                    </box>
                </geometry>
            </visual>
            <self_collide>0</self_collide>
            <gravity>1</gravity>
            <kinematic>0</kinematic>
        </link>
        <link name='left_track'>
            <pose>0 0.1985 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.0141 0 0 0</pose>
                <mass>6.06</mass>
                <inertia>
                    <ixx>0.002731</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.032554</iyy>
                    <iyz>1.5e-05</iyz>
                    <izz>0.031391</izz>
                </inertia>
            </inertial>
            <collision name='left_track_collision'>
                <pose>0 0 0.01855 1.5708 0 1.5708</pose>
                <geometry>
                    <box>
                        <size>0.09728 0.18094 0.5</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <collision name='left_track_collision_1'>
                <pose>0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <collision name='left_track_collision_2'>
                <pose>-0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name='left_track_visual'>
                <pose>0 0 0.01855 1.5708 0 1.5708</pose>
                <geometry>
                    <box>
                        <size>0.09728 0.18094 0.5</size>
                    </box>
                </geometry>
            </visual>
            <visual name='left_track_visual_1'>
                <pose>0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
            </visual>
            <visual name='left_track_visual_2'>
                <pose>-0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
            </visual>
            <gravity>1</gravity>
            <kinematic>0</kinematic>
        </link>
        <joint name='left_track_j' type='fixed'>
            <child>left_track</child>
            <parent>base_link</parent>
        </joint>
        <link name='right_track'>
            <pose>0 -0.1985 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.0141 0 0 0</pose>
                <mass>6.06</mass>
                <inertia>
                    <ixx>0.002731</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.032554</iyy>
                    <iyz>1.5e-05</iyz>
                    <izz>0.031391</izz>
                </inertia>
            </inertial>
            <collision name='right_track_collision'>
                <pose>0 0 0.01855 1.5708 0 1.5708</pose>
                <geometry>
                    <box>
                        <size>0.09728 0.18094 0.5</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <collision name='right_track_collision_1'>
                <pose>0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <collision name='right_track_collision_2'>
                <pose>-0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.7</mu>
                            <mu2>150</mu2>
                            <fdir1>0 1 0</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name='right_track_visual'>
                <pose>0 0 0.01855 1.5708 0 1.5708</pose>
                <geometry>
                    <box>
                        <size>0.09728 0.18094 0.5</size>
                    </box>
                </geometry>
            </visual>
            <visual name='right_track_visual_1'>
                <pose>0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
            </visual>
            <visual name='right_track_visual_2'>
                <pose>-0.25 0 0.01855 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.09728</length>
                        <radius>0.09047</radius>
                    </cylinder>
                </geometry>
            </visual>
            <gravity>1</gravity>
            <kinematic>0</kinematic>
        </link>
        <joint name='right_track_j' type='fixed'>
            <child>right_track</child>
            <parent>base_link</parent>
        </joint>

        <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
            <left_track><link>left_track</link></left_track>
            <right_track><link>right_track</link></right_track>
            <tracks_separation>0.4</tracks_separation>
            <tracks_height>0.18094</tracks_height>
            <steering_efficiency>0.5</steering_efficiency>
            <!--debug>1</debug-->
        </plugin>
        <plugin name='gz::sim::systems::TrackController' filename='gz-sim-track-controller-system'>
            <link>left_track</link>
            <min_velocity>-1.0</min_velocity>
            <max_velocity>1.0</max_velocity>
            <!--debug>1</debug-->
        </plugin>
        <plugin name='gz::sim::systems::TrackController' filename='gz-sim-track-controller-system'>
            <link>right_track</link>
            <min_velocity>-1.0</min_velocity>
            <max_velocity>1.0</max_velocity>
        </plugin>

        <!-- TrackedVehicle のオドメトリは旋回で大きくずれるため、真値を位置として使う -->
        <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
            <dimensions>3</dimensions>
            <odom_topic>/model/crawler/ground_truth</odom_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>
    </model>
</sdf>
